# ============================================================
# FRIDAY SUPABASE CREDENTIALS
# Copy this file to .env.supabase and paste your values.
# The .env.supabase file is git-ignored and never committed.
# ============================================================

SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ============================================================
# OPTIONAL BEHAVIOR
# ============================================================

# Set to true to require Supabase on startup.
# When false (default), FRIDAY falls back to file-based storage
# if Supabase is unavailable or not configured.
SUPABASE_REQUIRED=false
