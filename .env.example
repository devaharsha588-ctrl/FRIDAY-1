NODE_ENV=development

# Web/backend
FRIDAY_BACKEND_PORT=3001
FRIDAY_AGENT_URL=http://127.0.0.1:8787

# Local desktop agent. Change this for real use; this value is only a dev default.
FRIDAY_AGENT_PORT=8787
FRIDAY_AGENT_TOKEN=dev-local-token-change-me
FRIDAY_FILES_ROOT=.

# Optional allowlist for desktop app launching.
# Example:
# FRIDAY_ALLOWED_APPS={"notepad":{"command":"notepad.exe","args":[],"processName":"notepad.exe"},"calculator":{"command":"calc.exe","args":[],"processName":"CalculatorApp.exe"}}
FRIDAY_ALLOWED_APPS=

# OpenRouter configuration. The browser never receives these keys.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_DEFAULT_API_KEY=
OPENROUTER_DEFAULT_MODEL=

OPENROUTER_GENERAL_API_KEY=
OPENROUTER_GENERAL_MODEL=
OPENROUTER_CODING_API_KEY=
OPENROUTER_CODING_MODEL=
OPENROUTER_PLANNING_API_KEY=
OPENROUTER_PLANNING_MODEL=
OPENROUTER_COMPUTER_API_KEY=
OPENROUTER_COMPUTER_MODEL=
OPENROUTER_VISION_API_KEY=
OPENROUTER_VISION_MODEL=
OPENROUTER_FAST_API_KEY=
OPENROUTER_FAST_MODEL=

